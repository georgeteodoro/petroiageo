time python3 header.py > tmp_data/nwells-1.csv
time python3 expand.py 1 test-adriano/porosity-canal.txt >> tmp_data/nwells-1.csv
time python3 petro.py tmp_data/nwells-1.csv > tmp_data/w1
grep -v "remover" apply3.py > tmp_data/v; mv tmp_data/v apply3.py
cat tmp_data/w1 | sed "s/,0\./+0\./g" | gawk 'BEGIN{FS="+"}{print($2,$3,$1)}' | LC_ALL=C sort -nk 2 | head -1 | gawk 'BEGIN{FS="["}{print("f = ["$2" #remover"); print("eval_model(df, f) #remover")}' >> apply3.py
time python3 apply3.py tmp_data/nwells-1.csv > tmp_data/v
cat tmp_data/v | gawk '{print("a "$0)}' > tmp_data/v2
cat tmp_data/v2 tmp_data/v | gawk '{if($1=="a") {a[$2" "$3" "$4]=$5; b[$2" "$3" "$4]=1;} else {for(i=$1-1;i<=$1+1;i++) for(j=$2-1;j<=$2+1;j++) {if(b[i" "j" "$3]!=1) {a[i" "j" "$3]+=$4; c[i" "j" "$3]++;}}}}END{for(i in a) {if(b[i]==1) print(i, a[i]); else print(i, a[i]/c[i])}}' | LC_ALL=C sort -nk1,1 -nk2,2 -nk3,3 | gawk '{if($3<251) print($0)}' > tmp_data/values

